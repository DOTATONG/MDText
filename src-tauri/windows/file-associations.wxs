<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(sys.BUILDARCH)="x86"?>
    <?define MDTextWin64 = "no"?>
  <?else?>
    <?define MDTextWin64 = "yes"?>
  <?endif?>

  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FileAssociationRegistry" Guid="bf7cc866-bb4c-4d9c-b35d-63360fc9fbaa" Win64="$(var.MDTextWin64)">
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Applications\mdtext.exe"
          Name="MDTextFileAssociation"
          Type="integer"
          Value="1"
          KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Classes\.md" Type="string" Value="MDText.md" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.markdown" Type="string" Value="MDText.markdown" />
        <!-- Joins the right-click "Open with" list even when the user picks a different default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="MDText.md" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.markdown\OpenWithProgids" Name="MDText.markdown" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.md" Type="string" Value="Markdown text document" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.md" Name="FriendlyTypeName" Type="string" Value="Markdown text document" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.md\DefaultIcon" Type="string" Value="&quot;[INSTALLDIR]mdtext.exe&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.md\shell\open" Type="string" Value="Open with MDText" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.md\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]mdtext.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.markdown" Type="string" Value="Markdown text document" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.markdown" Name="FriendlyTypeName" Type="string" Value="Markdown text document" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.markdown\DefaultIcon" Type="string" Value="&quot;[INSTALLDIR]mdtext.exe&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.markdown\shell\open" Type="string" Value="Open with MDText" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MDText.markdown\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]mdtext.exe&quot; &quot;%1&quot;" />

        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Applications\mdtext.exe"
          Name="FriendlyAppName"
          Type="string"
          Value="MDText" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Applications\mdtext.exe"
          Name="ApplicationIcon"
          Type="string"
          Value="[INSTALLDIR]mdtext.exe,0" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Applications\mdtext.exe\shell\open\command"
          Type="string"
          Value="&quot;[INSTALLDIR]mdtext.exe&quot; &quot;%1&quot;" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Applications\mdtext.exe\SupportedTypes"
          Name=".md"
          Type="string"
          Value="" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Applications\mdtext.exe\SupportedTypes"
          Name=".markdown"
          Type="string"
          Value="" />

        <RegistryValue
          Root="HKLM"
          Key="Software\MDText\Capabilities"
          Name="ApplicationName"
          Type="string"
          Value="MDText" />
        <RegistryValue
          Root="HKLM"
          Key="Software\MDText\Capabilities"
          Name="ApplicationDescription"
          Type="string"
          Value="Lightweight Markdown viewer and source editor." />
        <RegistryValue
          Root="HKLM"
          Key="Software\MDText\Capabilities\FileAssociations"
          Name=".md"
          Type="string"
          Value="MDText.md" />
        <RegistryValue
          Root="HKLM"
          Key="Software\MDText\Capabilities\FileAssociations"
          Name=".markdown"
          Type="string"
          Value="MDText.markdown" />
        <RegistryValue
          Root="HKLM"
          Key="Software\RegisteredApplications"
          Name="MDText"
          Type="string"
          Value="Software\MDText\Capabilities" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
